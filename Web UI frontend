Implementation

1. Context for Transcriptions (`TranscriptionContext.tsx`)
Create a context to manage global state for transcriptions.

```typescript
// src/context/TranscriptionContext.tsx
import React, { createContext, useContext, useState, ReactNode } from 'react';

interface TranscriptionContextType {
  transcriptions: string[];
  addTranscription: (transcription: string) => void;
}

const TranscriptionContext = createContext<TranscriptionContextType | undefined>(undefined);

export const TranscriptionProvider: React.FC<{ children: ReactNode }> = ({ children }) => {
  const [transcriptions, setTranscriptions] = useState<string[]>([]);

  const addTranscription = (transcription: string) => {
    setTranscriptions((prev) => [...prev, transcription]);
  };

  return (
    <TranscriptionContext.Provider value={{ transcriptions, addTranscription }}>
      {children}
    </TranscriptionContext.Provider>
  );
};

export const useTranscription = () => {
  const context = useContext(TranscriptionContext);
  if (!context) {
    throw new Error('useTranscription must be used within a TranscriptionProvider');
  }
  return context;
};
```

2. Custom Hook for Transcription (`useTranscribe.ts`)
Encapsulate API logic for audio transcription with error handling.

```typescript
// src/hooks/useTranscribe.ts
import { useMutation } from 'react-query';
import axios from 'axios';

const API_KEY = 'YOUR_DEEPGRAM_API_KEY';

const transcribeAudio = async (audioBlob: Blob) => {
  const formData = new FormData();
  formData.append('file', audioBlob);

  const response = await axios.post('https://api.deepgram.com/v1/listen', formData, {
    headers: {
      'Authorization': `Token ${API_KEY}`,
    },
  });

  return response.data.channel.alternatives[0].transcript;
};

export const useTranscribeAudio = () => {
  return useMutation(transcribeAudio, {
    onError: (error) => {
      console.error('Transcription error:', error);
    },
  });
};
```

3. Microphone Component (`Microphone.tsx`)
Create a responsive microphone component with visual feedback.

```typescript
// src/components/Microphone.tsx
import React, { useState, useRef } from 'react';

interface MicrophoneProps {
  onTranscribe: (audioBlob: Blob) => void;
}

const Microphone: React.FC<MicrophoneProps> = ({ onTranscribe }) => {
  const [isRecording, setIsRecording] = useState(false);
  const mediaRecorderRef = useRef<MediaRecorder | null>(null);

  const startRecording = async () => {
    const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
    mediaRecorderRef.current = new MediaRecorder(stream);

    mediaRecorderRef.current.ondataavailable = (event) => {
      if (event.data.size > 0) {
        onTranscribe(event.data);
      }
    };

    mediaRecorderRef.current.start();
    setIsRecording(true);
  };

  const stopRecording = () => {
    mediaRecorderRef.current?.stop();
    setIsRecording(false);
  };

  return (
    <div className="flex flex-col items-center">
      <button
        className={`p-4 rounded-full shadow-lg text-white ${isRecording ? 'bg-red-500' : 'bg-blue-500'} transition`}
        onClick={isRecording ? stopRecording : startRecording}
      >
        {isRecording ? 'Stop Recording' : 'Start Recording'}
      </button>
      <p className="mt-2 text-sm">{isRecording ? 'Recording...' : 'Click to record'}</p>
    </div>
  );
};

export default Microphone;
```

