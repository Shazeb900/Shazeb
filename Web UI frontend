 6. Past Transcriptions Component (`PastTranscriptions.tsx`)
Display saved transcriptions in an organized manner.

```typescript
// src/components/PastTranscriptions.tsx
import React from 'react';
import { useTranscription } from '../context/TranscriptionContext';

const PastTranscriptions: React.FC = () => {
  const { transcriptions } = useTranscription();

  return (
    <div className="mt-4">
      <h2 className="text-xl font-bold">Past Transcriptions:</h2>
      <ul>
        {transcriptions.length > 0 ? (
          transcriptions.map((transcription, index) => (
            <li key={index} className="border p-2 mt-2 bg-gray-50 rounded">
              {transcription}
            </li>
          ))
        ) : (
          <p>No past transcriptions available.</p>
        )}
      </ul>
    </div>
  );
};

export default PastTranscriptions;
```

7. Main Application (`App.tsx`)
Integrate all components and manage state effectively.

```typescript
// src/App.tsx
import React from 'react';
import { TranscriptionProvider, useTranscription } from './context/TranscriptionContext';
import Microphone from './components/Microphone';
import TranscriptionDisplay from './components/TranscriptionDisplay';
import PastTranscriptions from './components/PastTranscriptions';
import LoadingSpinner from './components/LoadingSpinner';
import { useTranscribeAudio } from './hooks/useTranscribe';

const App: React.FC = () => {
  const { addTranscription } = useTranscription();
  const { mutate, data, isLoading, isError, error } = useTranscribeAudio();

  const handleTranscription = (audioBlob: Blob) => {
    mutate(audioBlob, {
      onSuccess: (transcription) => {
        addTranscription(transcription);
      },
    });
  };

  return (
    <TranscriptionProvider>
      <div className="container mx-auto p-4">
        <h1 className="text-3xl font-bold">Audio Transcriber</h1>
        <Microphone onTranscribe={handleTranscription} />
        {isLoading && <LoadingSpinner />}
        {isError && <p className="text-red-500">{error.message}</p>}
        <TranscriptionDisplay transcription={data} />
        <PastTranscriptions />
      </div>
    </TranscriptionProvider>
  );
};

export default App;
```

